/* pushButton_connect */
QPushButton#pushButton_connect {
    background-color: #4CAF50;  /* 绿色背景 */
    color: white;                /* 白色文字 */
    font-size: 16px;             /* 字体大小 */
    border-radius: 10px;         /* 圆角 */
    padding: 10px;               /* 内边距 */
    border: 2px solid #388e3c;   /* 边框颜色和宽度 */
}

QPushButton#pushButton_connect:hover {
    background-color: #45a049;   /* 悬停时颜色变深 */
}

QPushButton#pushButton_connect:pressed {
    background-color: #388e3c;   /* 按下时颜色更深 */
}

QPushButton#pushButton_connect:disabled {
    background-color: #9e9e9e;   /* 禁用状态颜色 */
    color: #bdbdbd;              /* 禁用状态文字颜色 */
}

/* pushButton_disconnect */
QPushButton#pushButton_disconnect {
    background-color: #e74c3c;  /* 红色背景 */
    color: white;               /* 白色文字 */
    font-size: 16px;            /* 字体大小 */
    border-radius: 10px;        /* 圆角 */
    padding: 10px;              /* 内边距 */
    border: 2px solid #a93226;  /* 边框颜色和宽度 */
}

QPushButton#pushButton_disconnect:hover {
    background-color: #c0392b;  /* 悬停时颜色变深 */
}

QPushButton#pushButton_disconnect:pressed {
    background-color: #a93226;  /* 按下时颜色更深 */
}

QPushButton#pushButton_disconnect:disabled {
    background-color: #9e9e9e;   /* 禁用状态颜色 */
    color: #bdbdbd;              /* 禁用状态文字颜色 */
}

/* pushButton_update */
QPushButton#pushButton_update {
    background-color: #2980b9;  /* 蓝色背景 */
    color: white;               /* 白色文字 */
    font-size: 16px;            /* 字体大小 */
    border-radius: 10px;        /* 圆角 */
    padding: 10px;              /* 内边距 */
    border: 2px solid #1f618d;  /* 边框颜色和宽度 */
}

QPushButton#pushButton_update:hover {
    background-color: #2471a3;  /* 悬停时颜色变深 */
}

QPushButton#pushButton_update:pressed {
    background-color: #1f618d;  /* 按下时颜色更深 */
}

QPushButton#pushButton_update:disabled {
    background-color: #9e9e9e;   /* 禁用状态颜色 */
    color: #bdbdbd;              /* 禁用状态文字颜色 */
}

/* 通用样式 - 所有阈值标签 */
QLabel#label_tempThreshold,
QLabel#label_humiThreshold,
QLabel#label_pm25Threshold,
QLabel#label_pressThreshold,
QLabel#label_airQThreshold {
    font-size: 20px;                    /* 字体大小 */
    font-weight: bold;                  /* 字体加粗 */
    font-family: "Arial", "Helvetica", "sans-serif"; /* 设置字体 */
    color: #333;                        /* 字体颜色（深灰色） */
    background-color: #f8f1f2;         /* 背景颜色（淡灰粉色） */
    border: 1px solid #ccc;             /* 边框颜色（灰色） */
    border-radius: 5px;                 /* 圆角 */
    padding: 5px;                       /* 内边距 */
}

/* 悬停状态 */
QLabel#label_tempThreshold:hover,
QLabel#label_humiThreshold:hover,
QLabel#label_pm25Threshold:hover,
QLabel#label_pressThreshold:hover,
QLabel#label_airQThreshold:hover {
    background-color: #f0d4d6;          /* 悬停时背景颜色（稍深的灰粉色） */
}
/* 通用样式 - 所有设置阈值按钮 */
QPushButton#pushButton_set_tempThresholed,
QPushButton#pushButton_set_humiThresholed,
QPushButton#pushButton_set_PMThresholed,
QPushButton#pushButton_set_pressThresholed,
QPushButton#pushButton_set_airQThresholed {
    background-color: #66aaff;         /* 按钮背景颜色（柔和的蓝色） */
    color: white;                      /* 字体颜色（白色） */
    font-size: 14px;                   /* 字体大小 */
    font-weight: bold;                 /* 字体加粗 */
    border: 1px solid #007BFF;        /* 边框颜色（蓝色） */
    border-radius: 5px;                /* 圆角 */
    padding: 8px;                     /* 内边距 */
}

/* 悬停状态 */
QPushButton#pushButton_set_tempThresholed:hover,
QPushButton#pushButton_set_humiThresholed:hover,
QPushButton#pushButton_set_PMThresholed:hover,
QPushButton#pushButton_set_pressThresholed:hover,
QPushButton#pushButton_set_airQThresholed:hover {
    background-color: #5a9bd4;         /* 悬停时背景颜色（稍深的柔和蓝色） */
}

/* 按下状态 */
QPushButton#pushButton_set_tempThresholed:pressed,
QPushButton#pushButton_set_humiThresholed:pressed,
QPushButton#pushButton_set_PMThresholed:pressed,
QPushButton#pushButton_set_pressThresholed:pressed,
QPushButton#pushButton_set_airQThresholed:pressed {
    background-color: #4a90e2;         /* 按下时背景颜色（更深的柔和蓝色） */
}

/* 通用样式 - 所有输入阈值的 QLineEdit */
QLineEdit#lineEdit_tempThresholed,
QLineEdit#lineEdit_humiThresholed,
QLineEdit#lineEdit_PMThresholed,
QLineEdit#lineEdit_pressThresholed,
QLineEdit#lineEdit_airQThresholed {
    font-size: 16px;                    /* 字体大小 */
    color: #333;                        /* 字体颜色（深灰色） */
    background-color: #f9f9f9;         /* 背景颜色（浅灰色） */
    border: 1px solid #ccc;             /* 边框颜色（灰色） */
    border-radius: 5px;                 /* 圆角 */
    padding: 8px;                       /* 内边距 */
}

/* 焦点状态 */
QLineEdit#lineEdit_tempThresholed:focus,
QLineEdit#lineEdit_humiThresholed:focus,
QLineEdit#lineEdit_PMThresholed:focus,
QLineEdit#lineEdit_pressThresholed:focus,
QLineEdit#lineEdit_airQThresholed:focus {
    border: 2px solid #007BFF;         /* 聚焦时边框颜色（蓝色） */
    background-color: #e6f7ff;         /* 聚焦时背景颜色（浅蓝色） */
}

/* 占位符文本 */
QLineEdit#lineEdit_tempThresholed::placeholder,
QLineEdit#lineEdit_humiThresholed::placeholder,
QLineEdit#lineEdit_PMThresholed::placeholder,
QLineEdit#lineEdit_pressThresholed::placeholder,
QLineEdit#lineEdit_airQThresholed::placeholder {
    color: #999;                       /* 占位符颜色（浅灰色） */
}

/* 通用样式 - 所有标签 */
QLabel#label_osName,
QLabel#label_DEVNAME,
QLabel#label_time {
    font-size: 18px;                    /* 字体大小，增大 */
    font-weight: bold;                  /* 字体加粗 */
    font-family: "Arial", "Helvetica", "sans-serif"; /* 设置字体 */
    color: #333;                        /* 字体颜色（深灰色） */
    background-color: #f0f0f0;         /* 背景颜色（淡灰色） */
    border: none;                       /* 去掉边框 */
    border-radius: 5px;                 /* 圆角 */
    padding: 5px;                       /* 内边距 */
}

/* 悬停状态 */
QLabel#label_osName:hover,
QLabel#label_DEVNAME:hover,
QLabel#label_time:hover {
    background-color: #e6e6e6;          /* 悬停时背景颜色（稍深灰色） */
}
